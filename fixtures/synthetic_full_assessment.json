  "policies": {
    "service_control_policies": [
      {
        "id": "p-scp-001", "name": "DenyLeaveOrganization", "description": "Prevent members from leaving the org",
        "type": "SERVICE_CONTROL_POLICY", "aws_managed": false,
        "content": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Action": "organizations:LeaveOrganization", "Resource": "*"}]},
        "targets": [{"target_id": "r-abcd", "type": "ROOT", "name": "Root"}]
      },
      {
        "id": "p-scp-002", "name": "DenyRegionsExceptApproved", "description": "Only allow us-east-1, us-west-2, eu-west-1",
        "type": "SERVICE_CONTROL_POLICY", "aws_managed": false,
        "content": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Action": "*", "Resource": "*", "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["us-east-1", "us-west-2", "eu-west-1"]}}}]},
        "targets": [{"target_id": "ou-abcd-workloads", "type": "ORGANIZATIONAL_UNIT", "name": "Workloads"}]
      },
      {
        "id": "p-scp-003", "name": "DenyRootUserActions", "description": "Prevent root-user actions in member accounts",
        "type": "SERVICE_CONTROL_POLICY", "aws_managed": false,
        "content": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Action": "*", "Resource": "*", "Condition": {"StringLike": {"aws:PrincipalArn": "arn:aws:iam::*:root"}}}]},
        "targets": [{"target_id": "r-abcd", "type": "ROOT", "name": "Root"}]
      },
      {
        "id": "p-FullAWSAccess", "name": "FullAWSAccess", "description": "AWS-managed baseline",
        "type": "SERVICE_CONTROL_POLICY", "aws_managed": true,
        "content": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": "*", "Resource": "*"}]},
        "targets": [{"target_id": "r-abcd", "type": "ROOT", "name": "Root"}]
      }
    ],
    "tag_policies": [
      {
        "id": "p-tag-001", "name": "RequireCostCenterTag", "description": "Enforce CostCenter tag on all resources",
        "type": "TAG_POLICY", "aws_managed": false,
        "content": {"tags": {"CostCenter": {"tag_key": {"@@assign": "CostCenter"}, "enforced_for": {"@@assign": ["ec2:instance", "rds:db"]}}}},
        "targets": [{"target_id": "ou-abcd-workloads", "type": "ORGANIZATIONAL_UNIT", "name": "Workloads"}]
      }
    ],
    "backup_policies": [
      {
        "id": "p-bak-001", "name": "DailyProdBackups", "description": "Nightly backup for prod EBS+RDS",
        "type": "BACKUP_POLICY", "aws_managed": false,
        "content": {"plans": {"DailyProd": {"regions": {"@@assign": ["us-east-1"]}, "rules": {"NightlyToVault": {"schedule_expression": {"@@assign": "cron(0 5 * * ? *)"}, "target_backup_vault_name": {"@@assign": "central-vault"}, "lifecycle": {"delete_after_days": {"@@assign": "35"}}}}}}},
        "targets": [{"target_id": "ou-abcd-prod", "type": "ORGANIZATIONAL_UNIT", "name": "Prod"}]
      }
    ],
    "ai_opt_out_policies": [
      {
        "id": "p-ai-001", "name": "OptOutAllAIServices", "description": "Opt out of AI-service data usage org-wide",
        "type": "AISERVICES_OPT_OUT_POLICY", "aws_managed": false,
        "content": {"services": {"default": {"opt_out_policy": {"@@assign": "optOut"}}}},
        "targets": [{"target_id": "r-abcd", "type": "ROOT", "name": "Root"}]
      }
    ],
    "chatbot_policies": [
      {
        "id": "p-chat-001", "name": "DenySlackChannelChanges", "description": "Prevent members changing Slack integrations",
